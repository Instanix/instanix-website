# Public, non-secret configuration only. Never commit real secrets.
# Public origin of the marketing site (canonical URLs, sitemap, structured data).
NEXT_PUBLIC_SITE_URL=https://instanix.ae

# --- ZEUS assessment (server-side only; never prefix these with NEXT_PUBLIC_) ---
# OpenAI API key. Put the real value in apps/web/.env.local, never in source control.
OPENAI_API_KEY=
# Model ID used for the assessment. Set to a current OpenAI model that supports structured outputs.
OPENAI_MODEL=gpt-4.1
# Speech-to-text model for the voice prompt on the home page.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Contact channels shown after the assessment ---
# Calendly booking link, e.g. https://calendly.com/your-name/consultation
NEXT_PUBLIC_BOOKING_URL=
# WhatsApp number in international format without "+", e.g. 9715XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Lead storage (server-side only; never prefix these with NEXT_PUBLIC_) ---
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://mrqavqolzdttbdsfjfqc.supabase.co
# Service role key. It bypasses row level security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_I0SXlcG3zmj38OfVxQVzxg_QO0v9qPl

# --- New-lead email notification (server-side only) ---
# Zoho Mail: host smtp.zoho.com (paid/organization accounts: smtppro.zoho.com; other regions use their own
# domain, e.g. smtp.zoho.eu), port 465, user = the full mailbox address. With two-factor sign-in turned on,
# SMTP_PASSWORD must be an app-specific password generated in the Zoho account, not the normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional: where notifications go (defaults to SMTP_USER) and the From header.
LEADS_NOTIFY_TO=
SMTP_FROM=

# ---- AI spending controls (all optional; the defaults are shown) ----
# Set to 1 to switch off the live chat demo and voice input at once. The assessment stays on.
AI_DEMOS_DISABLED=
# Daily ceiling for all AI features together.
AI_LIMIT_TOTAL_PER_DAY=800
# Per feature: requests per visitor per hour, and per day for the whole site.
AI_LIMIT_ASSESSMENT_PER_VISITOR_HOUR=5
AI_LIMIT_ASSESSMENT_PER_DAY=100
AI_LIMIT_CHAT_PER_VISITOR_HOUR=18
AI_LIMIT_CHAT_PER_DAY=600
AI_LIMIT_TRANSCRIBE_PER_VISITOR_HOUR=10
AI_LIMIT_TRANSCRIBE_PER_DAY=200
